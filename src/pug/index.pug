doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title OGC Developers | Build Interoperable Geospatial Solutions with OGC Standards
    meta(name="description" content="The OGC developer hub — OGC APIs, encodings, code sprints, workshops, and community resources for building interoperable geospatial solutions.")
    link(rel="stylesheet" href="assets/style.css")
  body

    include ./includes/corner-ribbon

    include ./includes/header
    +header()

    // HERO
    section.hero
      .hero-split
        .col-text
          h1 Build interoperable geospatial solutions with OGC Standards
          .hero-bullets
            div
              span.dot ✓
              |  Providing a consistent way for different systems to interoperate and share geospatial data.
            div
              span.dot ✓
              |  Enabling applications to more easily access and use geospatial data from a wide variety of sources.
            div
              span.dot ✓
              |  Made by developers, for developers.
          .btn-row(style="justify-content:flex-start;margin-top:30px;")
            a.btn.btn-hero-outline(href="#learn") Learn
            a.btn.btn-hero-white(href="#get-started") Get Started
        .col-code
          .hero-code
            pre.code-panel(id="curl-snippet")
              | curl -X <span class="k">'GET'</span> \
              | 'https://demo.pygeoapi.io/master/collections/lakes/items?limit=10&skipGeometry=false&offset=0' \
              | -H <span class="s">'accept: application/geo+json'</span>
            button.btn-copy(onclick="navigator.clipboard.writeText(document.getElementById('curl-snippet').innerText); this.textContent='Copied ✓'; setTimeout(()=>this.textContent='Copy',1500);") Copy

    // TESTIMONIALS
    section#testimonials.dark-section
      .wrap
        .section-head
          p.eyebrow Testimonials
          h2 What Developers Say
          p Voices from the community on building with OGC Standards.
        .testi-carousel
          button.testi-arrow.left(onclick="testiMove(-1)" aria-label="Previous") ‹
          button.testi-arrow.right(onclick="testiMove(1)" aria-label="Next") ›
          .testi-track
            .testi-slide.active(data-initials="IS")
              p.testi-quote "So these OGC codesprints put the potential users together, so that we all try and make these APIs palatable for all. We won't make everybody happy, but we can try to make nobody hate the APIs."
              p.testi-attr — Ivan Sanchez Ortega, Freelance GIS+JS developer, OSGeo charter member
            .testi-slide(data-initials="TK")
              p.testi-quote "Exciting times for international weather/climate/water data exchange, using open Standards and open source reference implementations."
              p.testi-attr — Tom Kralidis, OSGeo Board Member, key contributor of FOSS4G projects
            .testi-slide(data-initials="SM")
              p.testi-quote "Using industry tools, you can take these specifications (OGC APIs) as is and easily generate service and client implementations…"
              p.testi-attr — Steve McDaniel, Software Scientist at Hexagon
            .testi-slide(data-initials="MG")
              p.testi-quote "The next generation of OGC API Standards make it easy for data publishers to create modern, developer friendly APIs to access geospatial data…"
              p.testi-attr — Michael Gordon, Strategic Product Manager at Ordnance Survey
            .testi-slide(data-initials="AA")
              p.testi-quote "The new OGC-APIs allow you to access the features of the SDI datasets of Spain (hydrography, land use and cover, transport networks…) in a simple and friendly way…"
              p.testi-attr — Aure Aragón Velasco, Technical Land Surveyor, Spanish SDI (IDEE IGN/CNIG)
            .testi-slide(data-initials="SL")
              p.testi-quote "OGC Standards underpin the transfer of geospatial datasets, and the OGC APIs reflect the use of cloud-hosted computing alongside being easier to understand…"
              p.testi-attr — Samantha Lavender, EO Scientist and Director at Pixalytics
            .testi-slide(data-initials="JG")
              p.testi-quote "In terms of data handling, the OGC API is easier because we can use it as if it were a REST API. It increases interoperability between GIS and non-GIS software. It allows for better data load management."
              p.testi-attr — João Filipe Gaspar, GIS Developer
          .testi-media
            .testi-ticks
              button.active(onclick="testiGoto(0)" aria-label="Slide 1")
              button(onclick="testiGoto(1)" aria-label="Slide 2")
              button(onclick="testiGoto(2)" aria-label="Slide 3")
              button(onclick="testiGoto(3)" aria-label="Slide 4")
              button(onclick="testiGoto(4)" aria-label="Slide 5")
              button(onclick="testiGoto(5)" aria-label="Slide 6")
              button(onclick="testiGoto(6)" aria-label="Slide 7")
            .testi-avatar#testi-avatar IS

    script.
      (function(){
        var slides = document.querySelectorAll('.testi-slide');
        var ticks = document.querySelectorAll('.testi-ticks button');
        var avatar = document.getElementById('testi-avatar');
        var idx = 0, timer;
        function show(i){
          idx = (i + slides.length) % slides.length;
          slides.forEach(function(s, n){ s.classList.toggle('active', n === idx); });
          ticks.forEach(function(t, n){ t.classList.toggle('active', n === idx); });
          var avatars = { IS:'assets/images/ivan.png', TK:'assets/images/tom.jpeg', SM:'assets/images/Steve_McDaniel_Head_Shot.png', MG:'assets/images/michael-os.png', AA:'assets/images/aure.jpg', SL: 'assets/images/slavender.jpeg', JG: 'assets/images/joao.jpeg'};
          var initials = slides[idx].getAttribute('data-initials'); avatar.innerHTML = avatars[initials] ? '<img src="' + avatars[initials] + '" alt="' + initials + '">' : initials;
        }
        window.testiMove = function(dir){ show(idx + dir); restart(); };
        window.testiGoto = function(i){ show(i); restart(); };
        function restart(){ clearInterval(timer); timer = setInterval(function(){ show(idx + 1); }, 7000); }
        show(0);
        restart();
      })();

