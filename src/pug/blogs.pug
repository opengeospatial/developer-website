doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title OGC Developer Blogs | Community Posts on OGC APIs &amp; Standards
    meta(name="description" content="Community blog posts from developers working with OGC APIs and Standards.")
    link(rel="stylesheet" href="assets/style.css")
  body

    include ./includes/corner-ribbon
    include ./includes/header
    +header('community')

    section.hero.hero-page
      .inner
        div
          .breadcrumb
            a(href="index.html") Developers
            |  / Blogs
          h1 Developer Blogs
          p.lead A collection of community blog posts from developers working with OGC APIs and Standards.

    section
      .wrap
        .article-list
          .article-row
            a(href="https://www.ogc.org/blog" target="_blank")
              div
                .meta OGC Blog
                h3 A space for sharing knowledge, innovation, and experiences in the geospatial world.
          .article-row
            a(href="https://www.linkedin.com/newsletters/random-gis-talks-6946681194994372608/" target="_blank")
              div
                .meta Random GIS Talks
                h3  Videos and articles about latest open source GIS technologies
          .article-row
            a(href="https://ivan.sanchezortega.es/" target="_blank")
              div
                .meta Iván Sánchez Ortega
                h3 Posts about maps and webpages
          .article-row
            a(href="https://anitagraser.com/" target="_blank")
              div
                .meta Free and Open Source GIS Ramblings
                h3 Notes from the Latest OGC Code Sprint
          .article-row
            a(href="https://blog.ianturton.com/" target="_blank")
              div
                .meta Ian's random blog
                h3  A repository for useful snippets of code that Ian develops in the course of writing a GeoTools Cookbook and other useful geospatial and java coding tips.
          .article-row
            a(href="https://justobjects.nl/" target="_blank")
              div
                .meta Just Objects
                h3 Professional activities of Just van den Broecke.
          .article-row
            a(href="https://www.w3.org/community/maps4html/" target="_blank")
              div
                .meta Maps 4 HTML
                h3 Maps For HTML Community Group            

    include ./includes/cta
    +ctaBox()

    include ./includes/footer
// test
